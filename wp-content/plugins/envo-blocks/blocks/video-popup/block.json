{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/video-popup",
	"title": "Video Popup",
	"category": "envo-blocks",
	"icon": "video-alt3",
	"description": "A play button, or an image with a play button, that opens a YouTube, Vimeo, Dailymotion or own video in a pop-up window. Nothing is loaded from the video site before the click.",
	"keywords": [ "video", "popup", "lightbox", "youtube", "vimeo", "play", "modal" ],
	"textdomain": "envo-blocks",
	"attributes": {
		"videoUrl": { "type": "string", "default": "" },
		"videoTitle": { "type": "string", "default": "" },
		"startAt": { "type": "integer", "default": 0 },
		"layout": { "type": "string", "default": "image" },
		"imageId": { "type": "integer", "default": 0 },
		"imageUrl": { "type": "string", "default": "" },
		"imageAlt": { "type": "string", "default": "" },
		"aspectRatio": { "type": "string", "default": "16/9" },
		"overlayColor": { "type": "string", "default": "" },
		"radius": { "type": "integer", "default": 14 },
		"hoverZoom": { "type": "boolean", "default": true },
		"caption": { "type": "string", "default": "" },
		"iconStyle": { "type": "string", "default": "filled" },
		"iconSize": { "type": "integer", "default": 84 },
		"pulse": { "type": "boolean", "default": true },
		"label": { "type": "string", "default": "" },
		"labelPosition": { "type": "string", "default": "right" },
		"contentAlign": { "type": "string", "default": "center" },
		"iconColor": { "type": "string", "default": "" },
		"iconBackground": { "type": "string", "default": "" },
		"labelColor": { "type": "string", "default": "" },
		"popupWidth": { "type": "integer", "default": 1000 },
		"popupRatio": { "type": "string", "default": "16/9" },
		"backdropColor": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"viewScript": "envo-blocks-video",
	"render": "file:./render.php"
}
