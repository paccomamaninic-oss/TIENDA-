{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/form-styler",
	"title": "Form Styler",
	"category": "envo-blocks",
	"icon": "feedback",
	"description": "A form of Contact Form 7, WPForms, Fluent Forms, Ninja Forms, Formidable Forms, Forminator or Gravity Forms in your own style: fields, labels, the button and the messages.",
	"keywords": [ "form", "contact form", "contact form 7", "wpforms", "fluent forms", "ninja forms", "formidable", "forminator", "gravity forms", "styler" ],
	"textdomain": "envo-blocks",
	"attributes": {
		"plugin": { "type": "string", "default": "" },
		"formId": { "type": "string", "default": "" },
		"shortcode": { "type": "string", "default": "" },
		"fieldStyle": { "type": "string", "default": "outline" },
		"columns": { "type": "number", "default": 1 },
		"labelSize": { "type": "number", "default": 0 },
		"fieldRadius": { "type": "number", "default": 6 },
		"fieldPadding": { "type": "number", "default": 12 },
		"borderWidth": { "type": "number", "default": 1 },
		"fieldGap": { "type": "number", "default": 18 },
		"buttonWidth": { "type": "string", "default": "auto" },
		"buttonAlign": { "type": "string", "default": "left" },
		"buttonRadius": { "type": "number", "default": -1 },
		"labelColor": { "type": "string", "default": "" },
		"fieldBackground": { "type": "string", "default": "" },
		"fieldText": { "type": "string", "default": "" },
		"fieldBorder": { "type": "string", "default": "" },
		"focusColor": { "type": "string", "default": "" },
		"buttonBackground": { "type": "string", "default": "" },
		"buttonText": { "type": "string", "default": "" },
		"buttonHoverBackground": { "type": "string", "default": "" },
		"buttonHoverText": { "type": "string", "default": "" },
		"successColor": { "type": "string", "default": "" },
		"errorColor": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide" ],
		"color": { "background": true, "text": true },
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": [ "envo-blocks-blocks", "envo-blocks-form-styler" ],
	"render": "file:./render.php"
}
