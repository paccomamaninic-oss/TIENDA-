{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/pricing-table",
	"title": "Pricing Table",
	"category": "envo-blocks",
	"icon": "money-alt",
	"description": "Price plans side by side with a crossed-out old price, the billing period, a badge, a list of features and a button.",
	"keywords": [ "pricing", "price", "plans", "table", "discount", "subscription" ],
	"textdomain": "envo-blocks",
	"attributes": {
		"plans": { "type": "array", "items": { "type": "object" } },
		"columns": { "type": "integer", "default": 3 },
		"currency": { "type": "string", "default": "$" },
		"currencyPosition": { "type": "string", "default": "before" },
		"showSavings": { "type": "boolean", "default": true },
		"savingsText": { "type": "string", "default": "" },
		"contentAlign": { "type": "string", "default": "center" },
		"cardStyle": { "type": "string", "default": "border" },
		"radius": { "type": "integer", "default": 14 },
		"gap": { "type": "integer", "default": 24 },
		"featuredScale": { "type": "boolean", "default": true },
		"buttonFullWidth": { "type": "boolean", "default": true },
		"priceSize": { "type": "integer", "default": 48 },
		"accentColor": { "type": "string", "default": "" },
		"cardBackground": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" },
		"featuredBackground": { "type": "string", "default": "" },
		"featuredText": { "type": "string", "default": "" },
		"oldPriceColor": { "type": "string", "default": "" },
		"badgeBackground": { "type": "string", "default": "" },
		"badgeText": { "type": "string", "default": "" },
		"buttonBackground": { "type": "string", "default": "" },
		"buttonText": { "type": "string", "default": "" },
		"checkColor": { "type": "string", "default": "" },
		"savingsColor": { "type": "string", "default": "" },
		"borderColor": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"render": "file:./render.php"
}
