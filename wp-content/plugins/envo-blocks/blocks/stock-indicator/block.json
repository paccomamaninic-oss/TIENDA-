{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/stock-indicator",
	"title": "Stock Indicator",
	"category": "envo-blocks",
	"icon": "chart-bar",
	"description": "\"Only 3 left in stock\" with a bar, from the real stock of the product (WooCommerce stock management). For variable products it follows the chosen variation.",
	"keywords": [ "stock", "inventory", "scarcity", "left", "quantity", "woocommerce" ],
	"textdomain": "envo-blocks",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"source": { "type": "string", "default": "current" },
		"productId": { "type": "integer", "default": 0 },
		"threshold": { "type": "integer", "default": 10 },
		"barFull": { "type": "integer", "default": 20 },
		"showBar": { "type": "boolean", "default": true },
		"showIcon": { "type": "boolean", "default": true },
		"showInStock": { "type": "boolean", "default": false },
		"showOutOfStock": { "type": "boolean", "default": true },
		"lowText": { "type": "string", "default": "" },
		"inStockText": { "type": "string", "default": "" },
		"outText": { "type": "string", "default": "" },
		"backorderText": { "type": "string", "default": "" },
		"barColor": { "type": "string", "default": "" },
		"trackColor": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"viewScript": "envo-blocks-stock",
	"render": "file:./render.php"
}
