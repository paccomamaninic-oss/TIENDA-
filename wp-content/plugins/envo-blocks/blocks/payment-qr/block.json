{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/payment-qr",
	"title": "Payment QR Code",
	"category": "envo-blocks",
	"icon": "money-alt",
	"description": "A payment QR code for orders paid by direct bank transfer – QR Platba (CZK) or EPC QR / SEPA (EUR) with the account, amount and reference – for the order confirmation page.",
	"keywords": [ "qr code", "bank transfer", "qr platba", "epc", "sepa", "girocode", "payment", "order confirmation", "woocommerce" ],
	"textdomain": "envo-blocks",
	"attributes": {
		"title": { "type": "string", "default": "" },
		"description": { "type": "string", "default": "" },
		"format": { "type": "string", "default": "" },
		"account": { "type": "string", "default": "" },
		"message": { "type": "string", "default": "" },
		"showDetails": { "type": "boolean", "default": true },
		"layout": { "type": "string", "default": "side" },
		"qrSize": { "type": "integer", "default": 200 },
		"boxStyle": { "type": "string", "default": "box" },
		"background": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide" ],
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"render": "file:./render.php"
}
