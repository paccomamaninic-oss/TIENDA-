{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/coupon-box",
	"title": "Coupon Code Box",
	"category": "envo-blocks",
	"icon": "tickets-alt",
	"description": "Highlights a WooCommerce coupon with a copy button and an optional \"Apply to cart\" button. The discount, minimum and expiry date are read from the coupon.",
	"keywords": [ "coupon", "discount", "code", "voucher", "sale", "woocommerce" ],
	"textdomain": "envo-blocks",
	"attributes": {
		"code": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"description": { "type": "string", "default": "" },
		"showDiscount": { "type": "boolean", "default": true },
		"showMinimum": { "type": "boolean", "default": true },
		"showExpiry": { "type": "boolean", "default": true },
		"hideInvalid": { "type": "boolean", "default": true },
		"copyText": { "type": "string", "default": "" },
		"copiedText": { "type": "string", "default": "" },
		"applyButton": { "type": "boolean", "default": false },
		"applyText": { "type": "string", "default": "" },
		"boxStyle": { "type": "string", "default": "dashed" },
		"layout": { "type": "string", "default": "row" },
		"accentColor": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" },
		"background": { "type": "string", "default": "" },
		"codeBackground": { "type": "string", "default": "" },
		"buttonColor": { "type": "string", "default": "" },
		"buttonText": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"viewScript": "envo-blocks-coupon",
	"render": "file:./render.php"
}
