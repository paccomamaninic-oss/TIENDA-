{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/sticky-column",
	"title": "Sticky Column",
	"category": "envo-blocks",
	"icon": "sticky",
	"description": "Blocks that stay in view while the page scrolls – inside their column or group, like a sticky sidebar. A tall one floats up and down with the scrolling.",
	"keywords": [ "sticky", "sidebar", "fixed", "column", "scroll", "table of contents", "summary" ],
	"textdomain": "envo-blocks",
	"attributes": {
		"offsetMode": { "type": "string", "default": "auto" },
		"offset": { "type": "integer", "default": 24 },
		"bottomOffset": { "type": "integer", "default": 24 },
		"until": { "type": "string", "default": "mobile" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": { "margin": [ "top", "bottom" ], "padding": true },
		"color": { "background": true, "text": true },
		"__experimentalBorder": { "radius": true, "width": true, "color": true }
	},
	"example": {
		"innerBlocks": [
			{ "name": "core/heading", "attributes": { "content": "On this page", "level": 4 } }
		]
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": [ "envo-blocks-blocks", "envo-blocks-sticky" ],
	"viewScript": "envo-blocks-sticky",
	"render": "file:./render.php"
}
