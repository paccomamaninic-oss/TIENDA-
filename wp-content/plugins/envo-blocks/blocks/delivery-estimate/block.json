{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/delivery-estimate",
	"title": "Delivery Estimate",
	"category": "envo-blocks",
	"icon": "clock",
	"description": "\"Order within 2 h 15 min and we ship it today\" with the estimated delivery date. Counts with the cut-off time, shipping days and holidays.",
	"keywords": [ "delivery", "shipping", "countdown", "cutoff", "dispatch", "woocommerce" ],
	"textdomain": "envo-blocks",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"cutoff": { "type": "string", "default": "14:00" },
		"shipDays": { "type": "array", "default": [ 1, 2, 3, 4, 5 ], "items": { "type": "integer" } },
		"deliveryDays": { "type": "array", "default": [ 1, 2, 3, 4, 5 ], "items": { "type": "integer" } },
		"holidays": { "type": "string", "default": "" },
		"processingDays": { "type": "integer", "default": 0 },
		"deliveryMin": { "type": "integer", "default": 1 },
		"deliveryMax": { "type": "integer", "default": 2 },
		"showDelivery": { "type": "boolean", "default": true },
		"showSeconds": { "type": "boolean", "default": false },
		"showIcon": { "type": "boolean", "default": true },
		"hideOutOfStock": { "type": "boolean", "default": true },
		"messageToday": { "type": "string", "default": "" },
		"messageLater": { "type": "string", "default": "" },
		"messageDelivery": { "type": "string", "default": "" },
		"boxStyle": { "type": "string", "default": "box" },
		"iconColor": { "type": "string", "default": "" },
		"highlightColor": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" },
		"background": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"viewScript": "envo-blocks-delivery",
	"render": "file:./render.php"
}
