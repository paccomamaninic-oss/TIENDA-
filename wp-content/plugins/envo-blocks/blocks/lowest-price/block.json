{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/lowest-price",
	"title": "Lowest Price",
	"category": "envo-blocks",
	"icon": "chart-line",
	"description": "\"Lowest price in the last 30 days\" for a discount, as the EU Omnibus rule asks – from the real price history of the product. For variable products it follows the chosen variation.",
	"keywords": [ "lowest price", "omnibus", "price history", "30 days", "discount", "sale", "woocommerce" ],
	"textdomain": "envo-blocks",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"source": { "type": "string", "default": "current" },
		"productId": { "type": "integer", "default": 0 },
		"days": { "type": "integer", "default": 0 },
		"showWhen": { "type": "string", "default": "" },
		"text": { "type": "string", "default": "" },
		"boxStyle": { "type": "string", "default": "plain" },
		"textColor": { "type": "string", "default": "" },
		"priceColor": { "type": "string", "default": "" },
		"background": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"viewScript": "envo-blocks-lowest",
	"render": "file:./render.php"
}
