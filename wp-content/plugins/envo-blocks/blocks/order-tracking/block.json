{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/order-tracking",
	"title": "Order Tracking",
	"category": "envo-blocks",
	"icon": "location",
	"description": "The WooCommerce order tracking form (order number and billing email) with a heading, a short text and your colors – for a \"Track your order\" page.",
	"keywords": [ "order tracking", "track order", "status", "shipment", "woocommerce" ],
	"textdomain": "envo-blocks",
	"attributes": {
		"title": { "type": "string", "default": "" },
		"description": { "type": "string", "default": "" },
		"boxStyle": { "type": "string", "default": "box" },
		"textAlign": { "type": "string", "default": "left" },
		"maxWidth": { "type": "integer", "default": 640 },
		"background": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" },
		"buttonColor": { "type": "string", "default": "" },
		"buttonText": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide" ],
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"render": "file:./render.php"
}
