{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/rating-summary",
	"title": "Rating Summary",
	"category": "envo-blocks",
	"icon": "star-half",
	"description": "Average rating with stars and a breakdown of the 5★ to 1★ reviews, for the current product, a chosen product or the whole shop.",
	"keywords": [ "rating", "reviews", "stars", "histogram", "breakdown", "woocommerce" ],
	"textdomain": "envo-blocks",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"source": { "type": "string", "default": "current" },
		"productId": { "type": "integer", "default": 0 },
		"heading": { "type": "string", "default": "" },
		"layout": { "type": "string", "default": "side" },
		"showAverage": { "type": "boolean", "default": true },
		"showCount": { "type": "boolean", "default": true },
		"showBars": { "type": "boolean", "default": true },
		"barValue": { "type": "string", "default": "count" },
		"barHeight": { "type": "integer", "default": 8 },
		"showLink": { "type": "boolean", "default": true },
		"linkText": { "type": "string", "default": "" },
		"hideEmpty": { "type": "boolean", "default": false },
		"starColor": { "type": "string", "default": "" },
		"barColor": { "type": "string", "default": "" },
		"trackColor": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" },
		"background": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"render": "file:./render.php"
}
