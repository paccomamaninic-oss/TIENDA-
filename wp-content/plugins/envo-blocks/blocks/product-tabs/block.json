{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/product-tabs",
	"title": "Product Tabs",
	"category": "envo-blocks",
	"icon": "index-card",
	"description": "The tabs of the product page in your order and design: description, additional information, reviews, own tabs made of blocks and the product's own tabs. Tabs on top, left or right, or an accordion.",
	"keywords": [ "tabs", "product tabs", "description", "reviews", "additional information", "accordion", "woocommerce" ],
	"textdomain": "envo-blocks",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"source": { "type": "string", "default": "current" },
		"productId": { "type": "integer", "default": 0 },
		"layout": { "type": "string", "default": "tabs" },
		"navPosition": { "type": "string", "default": "top" },
		"tabStyle": { "type": "string", "default": "underline" },
		"navAlign": { "type": "string", "default": "left" },
		"navWidth": { "type": "integer", "default": 220 },
		"mobileAccordion": { "type": "boolean", "default": true },
		"firstOpen": { "type": "boolean", "default": true },
		"allowMultiple": { "type": "boolean", "default": false },
		"showHeadings": { "type": "boolean", "default": false },
		"panelPadding": { "type": "integer", "default": 24 },
		"radius": { "type": "integer", "default": 6 },
		"tabColor": { "type": "string", "default": "" },
		"tabActiveColor": { "type": "string", "default": "" },
		"accentColor": { "type": "string", "default": "" },
		"tabBackground": { "type": "string", "default": "" },
		"tabActiveBackground": { "type": "string", "default": "" },
		"borderColor": { "type": "string", "default": "" },
		"panelBackground": { "type": "string", "default": "" },
		"panelText": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": [ "envo-blocks-blocks", "envo-blocks-product-tabs" ],
	"viewScript": "envo-blocks-product-tabs",
	"render": "file:./render.php"
}
