{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/map",
	"title": "Map",
	"category": "envo-blocks",
	"icon": "location-alt",
	"description": "A Google or OpenStreetMap map as a background, with any blocks on top of it (address, opening hours, a button). Can load only after a click, for privacy.",
	"keywords": [ "map", "google maps", "openstreetmap", "location", "address", "contact", "directions" ],
	"textdomain": "envo-blocks",
	"attributes": {
		"provider": { "type": "string", "default": "google" },
		"address": { "type": "string", "default": "" },
		"latitude": { "type": "string", "default": "" },
		"longitude": { "type": "string", "default": "" },
		"zoom": { "type": "integer", "default": 14 },
		"mapType": { "type": "string", "default": "roadmap" },
		"apiKey": { "type": "string", "default": "" },
		"heightMode": { "type": "string", "default": "px" },
		"height": { "type": "integer", "default": 480 },
		"grayscale": { "type": "boolean", "default": false },
		"overlayColor": { "type": "string", "default": "" },
		"interactive": { "type": "boolean", "default": true },
		"clickToLoad": { "type": "boolean", "default": false },
		"loadButtonText": { "type": "string", "default": "" },
		"loadNotice": { "type": "string", "default": "" },
		"showCard": { "type": "boolean", "default": true },
		"cardPosition": { "type": "string", "default": "left" },
		"cardVertical": { "type": "string", "default": "middle" },
		"cardWidth": { "type": "integer", "default": 380 },
		"cardRadius": { "type": "integer", "default": 12 },
		"stackOnMobile": { "type": "boolean", "default": true },
		"cardBackground": { "type": "string", "default": "" },
		"cardText": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"viewScript": "envo-blocks-map",
	"render": "file:./render.php"
}
