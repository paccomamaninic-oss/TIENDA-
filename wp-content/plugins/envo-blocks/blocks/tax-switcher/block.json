{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/tax-switcher",
	"title": "Tax Switcher",
	"category": "envo-blocks",
	"icon": "calculator",
	"description": "Lets visitors see the prices with or without tax (VAT) – a switch, two buttons or a dropdown for the header or the shop. Every price of the store follows. Shows only when WooCommerce calculates taxes.",
	"keywords": [ "tax", "vat", "prices", "incl", "excl", "net", "gross", "b2b", "switch", "toggle", "woocommerce" ],
	"textdomain": "envo-blocks",
	"attributes": {
		"variant": { "type": "string", "default": "buttons" },
		"order": { "type": "string", "default": "incl" },
		"showLabel": { "type": "boolean", "default": false },
		"label": { "type": "string", "default": "" },
		"inclText": { "type": "string", "default": "" },
		"exclText": { "type": "string", "default": "" },
		"justify": { "type": "string", "default": "left" },
		"radius": { "type": "integer", "default": 20 },
		"textColor": { "type": "string", "default": "" },
		"background": { "type": "string", "default": "" },
		"activeBackground": { "type": "string", "default": "" },
		"activeText": { "type": "string", "default": "" },
		"borderColor": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": [ "envo-blocks-blocks", "envo-blocks-tax-switcher" ],
	"viewScript": "envo-blocks-tax-switcher",
	"render": "file:./render.php"
}
