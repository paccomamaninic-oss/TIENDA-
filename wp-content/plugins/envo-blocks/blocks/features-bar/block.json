{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/features-bar",
	"title": "Features Bar",
	"category": "envo-blocks",
	"icon": "awards",
	"description": "A row of shop benefits with icons: free shipping, returns, support, secure payment and more.",
	"keywords": [ "usp", "benefits", "shipping", "returns", "icons", "woocommerce" ],
	"textdomain": "envo-blocks",
	"attributes": {
		"items": { "type": "array", "items": { "type": "object" } },
		"layout": { "type": "string", "default": "side" },
		"columns": { "type": "integer", "default": 4 },
		"columnsMobile": { "type": "integer", "default": 1 },
		"iconSize": { "type": "integer", "default": 36 },
		"iconStyle": { "type": "string", "default": "plain" },
		"dividers": { "type": "boolean", "default": true },
		"contentAlign": { "type": "string", "default": "center" },
		"iconColor": { "type": "string", "default": "" },
		"iconBackground": { "type": "string", "default": "" },
		"titleColor": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" },
		"background": { "type": "string", "default": "" },
		"dividerColor": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-blocks",
	"render": "file:./render.php"
}
