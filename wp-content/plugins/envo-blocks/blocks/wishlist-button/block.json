{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "envo-blocks/wishlist-button",
	"title": "Wishlist Button",
	"category": "envo-blocks",
	"icon": "heart",
	"description": "A heart that adds the product to the wishlist: on the product page, in a product template, or for a chosen product. Guests keep the list in the browser, customers in their account.",
	"keywords": [
		"wishlist",
		"favorite",
		"heart",
		"save for later",
		"like",
		"woocommerce"
	],
	"textdomain": "envo-blocks",
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"productId": {
			"type": "integer",
			"default": 0
		},
		"buttonStyle": {
			"type": "string",
			"default": "button"
		},
		"icon": {
			"type": "string",
			"default": "heart"
		},
		"iconSize": {
			"type": "integer",
			"default": 20
		},
		"addText": {
			"type": "string",
			"default": ""
		},
		"addedText": {
			"type": "string",
			"default": ""
		},
		"iconColor": {
			"type": "string",
			"default": ""
		},
		"activeColor": {
			"type": "string",
			"default": ""
		},
		"buttonBackground": {
			"type": "string",
			"default": ""
		},
		"borderColor": {
			"type": "string",
			"default": ""
		}
	},
	"styles": [
		{ "name": "default", "label": "Default", "isDefault": true },
		{ "name": "overlay", "label": "On the image" }
	],
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": {
			"margin": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "envo-blocks-blocks-editor",
	"editorStyle": "envo-blocks-blocks-editor",
	"style": "envo-blocks-wishlist",
	"viewScript": "envo-blocks-wishlist",
	"render": "file:./render.php"
}
